COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_DIR=C:/ComfyUI/ComfyUI_windows_portable/ComfyUI/user/default/workflows

# Copy to .env.local. Never commit the real values.
# Any non-empty password is accepted, including fewer than 6 characters.
STUDIO_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STUDIO_SESSION_SECRET=

# Server only. Use the dedicated comfy-studio-translator service account.
GOOGLE_TRANSLATE_PROJECT_ID=koharu-market-492802
GOOGLE_TRANSLATE_CREDENTIALS=C:/ComfyUI/comfy-studio/.data/secrets/google-translate.json

# Server-only CPU video encoder. Leave unset to use the bundled executable.
STUDIO_FFMPEG_PATH=C:/ComfyUI/ComfyUI_windows_portable/python_embeded/Lib/site-packages/imageio_ffmpeg/binaries/ffmpeg-win-x86_64-v7.1.exe
